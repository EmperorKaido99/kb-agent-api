# Copy this file to `.env` (same folder as docker-compose.yml) and fill in your real values.
# `.env` is gitignored — never commit your real one. Docker Compose loads it automatically.
#
# Nothing in this file is a secret — API user tokens are NOT configured here. They're created after
# the containers are running, via:
#   docker compose run --rm api dotnet KbAgent.Api.dll create-user <username>

# Folder scanned for documents (PowerPoint/Word/Excel/PDF/text/images). Can be a plain folder or a
# OneDrive/Google Drive folder synced to disk via their desktop app — both are just local paths here.
# Windows example: C:\Users\FMID Student\Documents\Knowledge Base
KB_FOLDER_PATH=./knowledge-base

# How often (minutes) the folder above is rescanned for new/changed files.
KB_SCAN_INTERVAL_MINUTES=15
