{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ollama": {
    "BackendBaseUrls": [
      "http://laptop1.local:11434",
      "http://laptop2.local:11434"
    ],
    "GenerationModel": "qwen3:1.7b",
    "EmbeddingModel": "nomic-embed-text",
    "RequestTimeoutSeconds": 60
  },
  "Qdrant": {
    "Host": "localhost",
    "Port": 6334,
    "UseTls": false,
    "CollectionName": "kb-chunks",
    "VectorSize": 768
  },
  "Chunking": {
    "ChunkSizeChars": 1000,
    "ChunkOverlapChars": 200
  },
  "Rag": {
    "TopK": 4
  },
  "ApiKey": {
    "Key": ""
  },
  "KnowledgeFolder": {
    "Path": "",
    "ScanIntervalMinutes": 15,
    "StateFilePath": "knowledge-folder-state.json"
  },
  "Ocr": {
    "TesseractExecutable": "tesseract",
    "Language": "eng",
    "TimeoutSeconds": 60
  }
}
